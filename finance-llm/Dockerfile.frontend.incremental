# Atualização **incremental** do frontend: reutiliza o nginx já configurado
# (`docker/nginx.conf` e a estrutura da imagem) e copia o `dist` construído no
# anfitrião, evitando o `npm ci` da build normal (que descarrega o `node_modules`
# todo outra vez).
#
# O `dist` tem de ser construído com `VITE_API_URL=/api`, para o browser falar
# com o nginx na mesma origem:
#   $env:VITE_API_URL='/api'; npm --prefix chat-ui run build
#
# Copia-se de `_frontend_dist` e não de `chat-ui/dist` porque o `.dockerignore`
# exclui `chat-ui/dist` do contexto da build (é preciso lá dentro para o build
# normal, mas aqui vem já feito):
#   Remove-Item -Recurse -Force _frontend_dist; Copy-Item -Recurse chat-ui\dist _frontend_dist
#
#   docker build -f Dockerfile.frontend.incremental -t iq-os-frontend:latest .
#
# A base é parametrizável (como no backend) para se poder assentar na etiqueta
# que já está validada, em vez de uma base antiga quando o resto do sistema já
# andou para a frente:
#   docker build -f Dockerfile.frontend.incremental --build-arg BASE=iq-os-frontend:latest -t iq-os-frontend:ontologia .
ARG BASE=iq-os-frontend:antes-deep-search
FROM ${BASE}

COPY _frontend_dist /usr/share/nginx/html
