# Atualização **incremental** do backend: reutiliza a imagem que já funciona
# como base, para não reinstalar as dependências.
#
# Porque existe: o `Dockerfile.backend` faz `pip install -r requirements.txt`
# sem versões fixas, e um rebuild a frio (cache das camadas invalidado) descarrega
# vários GB — incluindo as bibliotecas CUDA da NVIDIA (`nvidia_cudnn_cu13` 553 MB,
# `nvidia_nccl_cu13` 216 MB…) que um contentor **sem GPU** nunca usa. A imagem
# ficava com 12,3 GB e a build levava dezenas de minutos, além do risco de
# `pandas 3.x`/`transformers 5.x` quebrarem o código.
#
# Este ficheiro só substitui o **código**, mantendo as versões exatas que já
# estavam validadas. Usar o `Dockerfile.backend` quando for mesmo preciso mexer
# nas dependências.
#
#   docker build -f Dockerfile.backend.incremental -t iq-os-backend:latest .
#
# A base é parametrizável para se poder assentar numa etiqueta concreta que já
# esteja validada, em vez do `latest` (que pode ter sido reescrito por uma build
# a frio com dependências não testadas). Tem de ser uma **etiqueta**: o Docker
# não aceita um ID de imagem como `FROM`.
#   docker build -f Dockerfile.backend.incremental --build-arg BASE=iq-os-backend:validada -t iq-os-backend:latest .
ARG BASE=iq-os-backend:antes-deep-search
FROM ${BASE}

# WORKDIR (/app), ENTRYPOINT (/entrypoint.sh) e HEALTHCHECK vêm da base.

# Bibliotecas de sistema do Chromium (Playwright/Scrapling).
#
# A base não as tem: foi construída pelo ramo do `scrapling install`, que
# descarrega os binários mas não instala as dependências do `apt` — era o que o
# `|| playwright install --with-deps` devia cobrir e não cobria, porque o
# primeiro comando passava. Os browsers vivem no volume `playwright-cache`
# (`servicos/backend/compose.yml`), mas sem estas bibliotecas o Chromium morre
# ao arrancar com
#   chrome: error while loading shared libraries: libnspr4.so: cannot open
#   shared object file: No such file or directory
#
# É `install-deps` e não uma lista fixa: os nomes dos pacotes mudam com o Debian
# (`libasound2` → `libasound2t64`) e a lista derivada da versão instalada
# acompanha. Fica **antes** do `COPY . .` para não voltar a correr a cada deploy
# de código; numa base que já tenha as bibliotecas o `apt` não faz nada.
RUN playwright install-deps chromium && rm -rf /var/lib/apt/lists/*
COPY . .

# A SPA construída, para o backend poder escrever o `<head>` das páginas da
# interface (`_render_seo_index`, em `api/main.py`) — metadados por rota,
# `noindex` nas rotas privadas e 404 nos endereços que não existem.
#
# O `.dockerignore` exclui `chat-ui/dist` do contexto, por isso este `COPY` vem
# de `_frontend_dist` (o mesmo build que a imagem do frontend serve, produzido
# pelo `19-deploy-codigo.ps1` antes das builds). Sem isto o backend **da VM** não
# tinha `/app/chat-ui/dist/index.html` e respondia 404 a todas as rotas da SPA
# (localmente não se via: o compose monta `./chat-ui`, que lá tem o `dist`).
COPY _frontend_dist /app/chat-ui/dist

# O CLI do Soup **com o extra `[train]`**: a página de retreino lista, valida e
# lança treinos (`api/llm_contratos_soup.py`). O `[train]` acrescenta `trl`,
# `datasets`, `bitsandbytes`, `dill`, `multiprocess` e `fsspec` — nada disso
# toca em `torch`/`transformers`, mas o `pip` só aceita essa resolução com as
# versões actuais **fixadas**: sem o `-c`, voltava a resolver as duas e mudava
# o ambiente validado (o que este ficheiro existe para evitar). Se a base mudar
# de versões, a build falha aqui em vez de produzir uma imagem diferente.
RUN printf 'torch==2.14.1\ntransformers==5.19.0\n' > /tmp/constraints.txt \
    && pip install --no-cache-dir -c /tmp/constraints.txt "soup-cli[train]" \
    && rm -f /tmp/constraints.txt

# Dependências que o incremental tem de acrescentar à parte. São poucas e leves:
# o `requirements.txt` já as traz, mas uma build a frio resolveria também
# `pandas`/`transformers`/`numpy` **sem versões fixas** e mudaria o ambiente que
# está validado — que é exatamente o que este ficheiro existe para evitar.
# `edge-tts` dá ao Jarvis as vozes neurais pt-PT (`JARVIS_VOICE`) e o
# `faster-whisper` a transcrição local — incluindo a **palavra de ativação**
# (escuta contínua com o modelo `tiny`).
RUN pip install --no-cache-dir "edge-tts>=6.1.0" "faster-whisper>=1.0.0"

# `peft` e `accelerate` para **carregar o Adaptador LoRA**: a avaliação
# (`inference/contratos_eval.py`) e a adaptação incremental
# (`api/llm_contratos_treino.py`) fazem `from peft import PeftModel` e falhavam
# no contentor com `ModuleNotFoundError: No module named 'peft'` — a imagem base
# é anterior a essas dependências no `requirements.txt`.
#
# `--no-deps` + as poucas dependências que faltam, em vez de um `pip install peft`
# normal: assim o `pip` não tem liberdade para resolver `torch`/`transformers`
# outra vez (o objectivo deste ficheiro é manter exactamente as versões
# validadas). `psutil` e `safetensors` não vinham na base; `numpy`, `torch`,
# `transformers` e `huggingface_hub` já lá estão.
RUN pip install --no-cache-dir --no-deps "peft>=0.14.0" "accelerate>=0.30.0" \
    && pip install --no-cache-dir psutil safetensors
