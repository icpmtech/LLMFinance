# Frontend React + Vite para FinanceLLM
FROM node:22-slim AS builder

WORKDIR /app

# Copiar dependências primeiro para cache eficiente
COPY chat-ui/package.json ./
RUN npm install

# Copiar restante do frontend e fazer build
COPY chat-ui/ .
RUN npm run build

# Imagem final com nginx
FROM nginx:alpine

# Copiar configuração de nginx
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copiar build do frontend
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
