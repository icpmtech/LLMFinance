# Frontend React + Vite para IQ OS
FROM node:22-slim AS builder

WORKDIR /app

# Em produção o browser fala com o nginx (mesma origem) através do proxy /api/.
# Com um valor relativo não há CORS nem dependência do porto do backend no host.
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL

# URLs das aplicações de apoio incorporadas por iframe. Vazio (por omissão) =>
# a SPA usa o mesmo host do browser e as portas do compose (8888 SearXNG,
# 8891 n8n, 8892 dashboard do Hermes Agent, 8893 MiroFish, 8894 OSIF).
ARG VITE_SEARXNG_URL
ARG VITE_N8N_URL
ARG VITE_HERMES_URL
ARG VITE_MIROFISH_URL
ARG VITE_OSIF_URL
ENV VITE_SEARXNG_URL=$VITE_SEARXNG_URL \
    VITE_N8N_URL=$VITE_N8N_URL \
    VITE_HERMES_URL=$VITE_HERMES_URL \
    VITE_MIROFISH_URL=$VITE_MIROFISH_URL \
    VITE_OSIF_URL=$VITE_OSIF_URL

# Copiar dependências primeiro para cache eficiente
COPY chat-ui/package.json chat-ui/package-lock.json ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

# Copiar restante do frontend e fazer build
COPY chat-ui/ .
RUN npm run build

# Imagem final com nginx
FROM nginx:alpine

# Copiar configuração de nginx
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copiar build do frontend
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
