# Backend FastAPI para FinanceLLM
FROM python:3.11-slim

WORKDIR /app

# Evitar buffering de logs
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    FAISS_NO_GPU=1

# Dependências do sistema para compilar alguns pacotes python e suportar PDFs
# (libgl1-mesa-glx não existe em Debian bookworm; libgl1 + libgomp1 cobrem OpenCV/PyTorch)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Copiar e instalar dependências python
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir markitdown[pdf]

# Síntese local do Jarvis. Instala-se **aqui** — e não no `requirements.txt` —
# pelo mesmo motivo que o `markitdown`: o `requirements.txt` não é versionado
# neste repositório (`.gitignore`: `*.txt`), por isso o que fica no repositório
# (e chega a um clone) é esta linha.
RUN pip install --no-cache-dir piper-tts

# Voz local do Jarvis (Piper, pt-PT): o `.onnx` fica **na imagem**, para a
# síntese funcionar sem rede e sem depender da `edge-tts` (que devolve 403 a
# partir de vários hosts). Não se usa o `python -m piper.download_voices` de
# propósito — rebenta com nomes de voz não-ASCII (`UnicodeEncodeError` no `ã`
# de `tugão`), daí o URL percent-encoded.
RUN mkdir -p /opt/piper-voices && \
    curl -fsSL --retry 2 -o "/opt/piper-voices/pt_PT-tugão-medium.onnx" \
        "https://huggingface.co/rhasspy/piper-voices/resolve/main/pt/pt_PT/tug%C3%A3o/medium/pt_PT-tug%C3%A3o-medium.onnx?download=true" && \
    curl -fsSL --retry 2 -o "/opt/piper-voices/pt_PT-tugão-medium.onnx.json" \
        "https://huggingface.co/rhasspy/piper-voices/resolve/main/pt/pt_PT/tug%C3%A3o/medium/pt_PT-tug%C3%A3o-medium.onnx.json?download=true"

# Browsers do Playwright **na imagem** (fetchers `dynamic` e `stealth` das sondas).
# Instalá-los dentro do contentor (com `scrapling install`) perde-se quando o
# contentor é recriado — e a sonda passava a falhar com «Executable doesn't
# exist» a meio de uma recolha. Sem eles, os sites de lojas (Worten, Fnac, Darty)
# respondem 403 ao pedido simples.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN scrapling install || playwright install --with-deps chromium

# Copiar código do projeto
COPY . .

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import requests; requests.get('http://127.0.0.1:8000/health', timeout=5)" || exit 1

COPY docker/entrypoint.backend.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
