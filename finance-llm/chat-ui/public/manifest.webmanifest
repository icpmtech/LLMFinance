{
  "id": "/",
  "name": "IQ OS — Plataforma de Inteligência Financeira",
  "short_name": "IQ OS",
  "version": "1.3.0",
  "description": "Contratos públicos, empresas, mercados, previsões e chat com modelos de linguagem numa única plataforma.",
  "lang": "pt-PT",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "launch_handler": { "client_mode": "navigate-existing" },
  "orientation": "any",
  "background_color": "#0f1115",
  "theme_color": "#0f1115",
  "categories": ["finance", "business", "productivity"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "EmpresasIQ",
      "short_name": "EmpresasIQ",
      "url": "/empresas-iq",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Chat IA",
      "short_name": "Chat",
      "url": "/chat",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Contratos públicos",
      "short_name": "Contratos",
      "url": "/contracts/search",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Mercados",
      "short_name": "Mercados",
      "url": "/tickers",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Browser",
      "short_name": "Browser",
      "url": "/browser",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
