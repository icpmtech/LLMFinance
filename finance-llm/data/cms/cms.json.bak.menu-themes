        "parent_id": null,
        "template": "pagina-padrao",
        "blocks": [
          {
            "id": "blk_670bdd8e4f34",
            "type": "hero",
            "hidden": false,
            "data": {
              "title": "Benchmarks de produtos",
              "subtitle": "O mesmo produto comparado entre lojas, com o preço e a data de recolha à vista."
            }
          },
          {
            "id": "blk_bdfa5398b6c5",
            "type": "texto",
            "hidden": false,
            "data": {
              "title": "Como ler estes estudos",
              "markdown": "Cada benchmark recolhe os preços publicados por várias lojas, normaliza-os para o mesmo produto e mostra o melhor preço, a dispersão entre lojas e quanto se poupa ao escolher a oferta mais barata. Os dados são recolhidos automaticamente dos sites e podem estar desactualizados — confirme sempre na loja antes de decidir."
            }
          }
        ],
        "show_in_menu": true,
        "menu_order": 30,
        "menu_label": "",
        "excerpt": "Estudos de preço: o mesmo produto comparado em várias lojas.",
        "path": "benchmarks",
        "id": "pag_8a2796ff8ccb",
        "created_at": "2026-10-11T08:21:25.657781+00:00",
        "updated_at": "2026-10-11T08:21:25.657819+00:00",
        "published_at": "2026-10-11T08:21:25.657822+00:00"
