      "blocks": [
        {
          "id": "blk_solucoes_01_hero",
          "type": "hero",
          "hidden": false,
          "data": {
            "title": "O que fazemos, por área",
            "subtitle": "Seis áreas, a mesma regra: dado público, fonte nomeada e conta refazível.",
            "align": "esquerda",
