    {
      "id": "rev_25a48e1bea87",
      "entity": "pages",
      "entity_id": "pag_768f887fd8dd",
      "title": "Investigação assistida",
      "snapshot": {
        "title": "Investigação assistida",
        "slug": "investigacao",
        "status": "publicado",
        "scheduled_at": null,
        "updated_by": "migracao@sabemos.studio",
        "seo": {
          "title": "Investigação com evidências citadas",
          "description": "Investigação assistida sobre dados abertos: perguntas em linguagem natural, resposta com fontes citadas e grafo de evidências para seguir o rasto.",
          "keywords": [
            "investigação",
            "inteligência artificial",
            "evidências",
            "fontes citadas",
            "dados abertos",
            "Sabemos Studio"
          ],
          "image_id": null,
          "noindex": false
        },
        "parent_id": null,
        "template": "pagina-padrao",
        "blocks": [
          {
            "id": "blk_solucoes-investigacao_01_hero",
            "type": "hero",
            "hidden": false,
            "data": {
              "title": "Perguntar em português, receber a fonte",
              "subtitle": "A resposta vem com o documento que a sustenta — e com o rasto para o verificar.",
              "align": "esquerda"
            }
          },
          {
            "id": "blk_solucoes-investigacao_02_texto",
            "type": "texto",
            "hidden": false,
            "data": {
              "title": "O que muda face a uma pesquisa",
              "markdown": "Uma pesquisa devolve páginas. Aqui, a pergunta é feita em linguagem natural e a resposta é montada a partir de **dados ligados** — contratos, contas, registos de empresas — com cada afirmação ligada à evidência que a suporta.\n\nO resultado é verificável: se a conta não fechar, vê-se logo onde. E fica guardado como **dossiê**, com a data da leitura."
            }
          },
          {
            "id": "blk_solucoes-investigacao_03_passos",
            "type": "passos",
            "hidden": false,
            "data": {
              "title": "Como responde",
              "items": [
                {
                  "title": "Interpretar",
                  "text": "A pergunta é decomposta em sub-perguntas sobre entidades concretas."
                },
                {
                  "title": "Recolher",
                  "text": "Vão-se buscar os registos que respondem a cada uma, nas fontes certas."
                },
                {
                  "title": "Ligar",
                  "text": "Os registos são cruzados pela entidade — empresa, município ou pessoa."
                },
                {
                  "title": "Citar",
                  "text": "A resposta sai com as fontes numeradas, para abrir e conferir."
                }
              ]
            }
          },
          {
            "id": "blk_solucoes-investigacao_04_citacao",
            "type": "citacao",
            "hidden": false,
            "data": {
              "quote": "Cada número tem procedência: o documento, o ano e o contrato de onde saiu.",
              "author": "Método Sabemos Studio"
            }
          },
          {
            "id": "blk_solucoes-investigacao_05_cta",
            "type": "cta",
            "hidden": false,
            "data": {
              "title": "Tem uma pergunta que ninguém responde?",
              "text": "Diga-nos qual é. Construímos a resposta a partir dos dados abertos, com a evidência citada.",
              "button_label": "Fazer uma pergunta",
              "button_href": "/site/contactos"
            }
          }
        ],
        "show_in_menu": true,
        "menu_order": 0,
        "menu_label": "",
        "excerpt": "Perguntas em linguagem natural com resposta citada e grafo de evidências, sobre dados abertos ligados.",
        "path": "investigacao",
