                  "Despesas correntes e de capital",
                  "INE"
                ],
                [
                  "Despesas com pessoal",
                  "INE"
                ],
                [
                  "Contratos celebrados e valor",
                  "Portal BASE"
                ],
                [
                  "Adjudicatários do concelho",
                  "Portal BASE"
                ]
              ]
            }
          },
          {
            "id": "blk_solucoes-municipios_05_faq",
            "type": "faq",
            "hidden": false,
            "data": {
              "title": "Perguntas frequentes",
              "items": [
                {
                  "question": "Porque é que uns concelhos aparecem com mais anos?",
                  "answer": "Porque é assim que o INE publica: em séries temporais. Preenchemos o que existe e não estimamos o que falta."
                },
                {
                  "question": "Posso pedir a ficha de um concelho?",
                  "answer": "Sim. As fichas por concelho podem ser publicadas como páginas próprias, com o texto e os números lado a lado."
                }
              ]
