      "slug": "solucoes",
      "status": "publicado",
      "scheduled_at": null,
      "updated_by": "migracao@sabemos.studio",
      "seo": {
        "title": "Soluções",
        "description": "As seis áreas do Sabemos Studio: contratos públicos, empresas e pessoas, municípios, mercado e preços, benchmarks e investigação assistida.",
        "keywords": [
          "Sabemos Studio",
          "soluções",
          "contratos públicos",
          "dados abertos",
          "inteligência financeira"
        ],
        "image_id": null,
