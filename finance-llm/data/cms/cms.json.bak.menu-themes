    {
      "id": "rev_d253918b014d",
      "entity": "pages",
      "entity_id": "pag_c8cd7ab7f6ee",
      "title": "Contactos",
      "snapshot": {
        "title": "Contactos",
        "slug": "contactos",
        "status": "publicado",
        "scheduled_at": null,
        "updated_by": "migracao@sabemos.studio",
        "seo": {
          "title": "Contactos",
          "description": "Fale com o Sabemos Studio: pedidos de análise à medida, correções, dados e pedidos de imprensa. Respondemos por email.",
          "keywords": [
            "contactos",
            "Sabemos Studio",
            "pedido de análise",
            "imprensa"
          ],
          "image_id": null,
          "noindex": false
        },
        "parent_id": null,
        "template": "pagina-padrao",
        "blocks": [
          {
            "id": "blk_contactos_01_hero",
            "type": "hero",
            "hidden": false,
            "data": {
              "title": "Fale connosco",
              "subtitle": "Pedidos de análise, correções, dados ou imprensa — respondemos por email.",
              "align": "esquerda"
            }
          },
          {
            "id": "blk_contactos_02_texto",
            "type": "texto",
            "hidden": false,
            "data": {
              "title": "O que tratar aqui",
              "markdown": "- **Análise à medida** — uma pergunta concreta sobre contratos, empresas ou municípios.\n- **Correções** — um número que não bate certo. Damos prioridade e escrevemos a correção.\n- **Dados** — saber o que temos, com que cobertura e em que formato.\n- **Imprensa** — contexto, dados e a fonte primária por trás de cada número."
            }
          },
          {
            "id": "blk_contactos_03_formulario",
            "type": "formulario",
            "hidden": false,
            "data": {
              "title": "Pedido de contacto",
              "intro": "Quanto mais concreta for a pergunta, mais rápida é a resposta. Se for sobre uma entidade, indique o NIF.",
              "button_label": "Enviar mensagem"
            }
          },
          {
            "id": "blk_contactos_04_contactos",
            "type": "contactos",
            "hidden": false,
            "data": {
              "title": "Outros canais",
              "email": "geral@iqos.pt",
              "phone": "",
              "address": ""
            }
          },
          {
            "id": "blk_contactos_05_faq",
            "type": "faq",
            "hidden": false,
            "data": {
              "title": "Perguntas frequentes",
              "items": [
                {
                  "question": "Quanto tempo demoram a responder?",
                  "answer": "Pedidos simples, em dias úteis; análises à medida, dizemos o prazo quando soubermos o âmbito."
                },
                {
                  "question": "O que fazem com os meus dados?",
                  "answer": "Usamos o nome e o email apenas para responder a este pedido. Pode pedir a eliminação a qualquer momento, pela mesma via."
                }
              ]
            }
          }
        ],
