# Edge nginx do IQ OS na Kamatera.
#
# Template do entrypoint da imagem nginx:alpine: ${ORIGIN_HOSTNAME} e substituido
# a partir do `edge.env`. O NGINX_ENVSUBST_FILTER (no compose.yml) garante que so
# essa variavel e substituida — as do nginx ($host, $remote_addr) ficam intactas.
#
# A origem e o quick tunnel Cloudflare do PC (https://<aleatorio>.trycloudflare.com),
# por isso o proxy fala HTTPS com SNI.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    # Resolucao do hostname de origem em tempo de pedido (nao no arranque).
    resolver 127.0.0.11 valid=30s ipv6=off;

    client_max_body_size 512m;

    gzip on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "edge-ok\n";
    }

    location / {
        set $origin "https://${ORIGIN_HOSTNAME}";
        proxy_pass $origin;
        proxy_http_version 1.1;

        # A origem esta atras do Cloudflare: SNI obrigatorio.
        proxy_ssl_server_name on;
        proxy_ssl_name ${ORIGIN_HOSTNAME};

        proxy_set_header Host ${ORIGIN_HOSTNAME};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # O chat usa SSE e as importacoes demoram: sem buffering, timeout longo.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_connect_timeout 15s;
    }

    # Origem em baixo (PC desligado / tunel caido): pagina de manutencao.
    error_page 502 503 504 /offline.html;
    location = /offline.html {
        internal;
        root /usr/share/nginx/html;
    }
}
