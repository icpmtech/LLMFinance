# Caddy edge para sabemos.studio.
#
# Dois upstreams, ambos no loopback da VM (por isso o container corre com
# `network_mode: host`):
#
#   * `8090` — servico `landing`: pagina de apresentacao + formulario de registo.
#     Fica no edge para funcionar **mesmo com a origem em baixo**.
#   * `8080` — a origem (o PC), publicada por um tunel SSH reverso:
#
#         ssh -N -R 127.0.0.1:8080:127.0.0.1:4180 root@45.147.251.188
#
#     (ver `07-origin-tunnel.ps1` no PC).
#
#     Qual e a origem e **configuravel**, para se poder servir o site a partir da
#     propria VM em vez do PC:
#
#         ORIGEM_UPSTREAM=127.0.0.1:8080   -> o PC (pelo tunel)   [por omissao]
#         ORIGEM_UPSTREAM=127.0.0.1:4180   -> a SPA desta VM
#
#     Muda-se com `17-origem.ps1` (escreve o `edge/.env` e recria o Caddy).
#
#   * `8082` — Hermes Agent (dashboard), publicado por um segundo tunel SSH reverso:
#
#         ssh -N -R 127.0.0.1:8082:127.0.0.1:8892 root@45.147.251.188
#
# Nao ha Cloudflare: o unico ponto publico e este Caddy.
#
# Alem do site, este Caddy serve de **emissor de certificados**: o bloco
# `mail.sabemos.studio` no fim do ficheiro nao serve conteudo nenhum, existe para
# obter e renovar (desafio HTTP-01, porta 80) o certificado que o servidor de
# email da VM le do volume `edge_caddy_data`. Ver `servicos/mailserver/compose.yml`.

# Redireciona www para o apex.
www.sabemos.studio {
    redir https://sabemos.studio{uri} permanent
}

sabemos.studio {
    handle /healthz {
        respond "edge-ok" 200
    }

    # Registo de interessados — no edge, para funcionar com a origem offline.
    handle /api/public/* {
        reverse_proxy http://127.0.0.1:8090
    }

    # Apresentacao: sempre acessivel, para poder ser partilhada.
    handle /landing* {
        reverse_proxy http://127.0.0.1:8090
    }

    # Assets da apresentacao (CSS, JS e prints), num prefixo proprio para nao
    # colidirem com a SPA quando a pagina e servida como pagina de erro.
    handle /lp/* {
        reverse_proxy http://127.0.0.1:8090
    }

    # Mini portal de monitorizacao: servicos, imagens e estado da maquina.
    #
    # Servico proprio (`iqos-monitor`), **independente da aplicacao**. Nao passa
    # pelo `ORIGEM_UPSTREAM` de proposito: se passa-se, ficaria dependente do
    # tunel SSH e do backend, e ficaria em branco exactamente quando e preciso
    # saber o que se passou. Tem login de administrador proprio; a password vem
    # de `MONITOR_PASSWORD` no `edge/.env`.
    #
    # Espera o caminho completo (`/monitor/...`) — o servidor e que o desmonta,
    # via `BASE_PATH`, e redirecciona `/monitor` para `/monitor/` para os
    # caminhos relativos do HTML resolverem dentro do prefixo.
    handle /monitor* {
        reverse_proxy http://127.0.0.1:8091
    }

    # Hermes Agent dashboard — iframe "Hermes Agent" da SPA. O dashboard é
    # servido pelo próprio nginx da origem (127.0.0.1:8080) sob o subcaminho
    # /hermes-agent/; o nginx reescreve caminhos absolutos e injeta <base href>
    # para que a app funcione same-origin em https://sabemos.studio/hermes-agent/.
    handle /hermes-agent/* {
        reverse_proxy http://{$ORIGEM_UPSTREAM:127.0.0.1:8080} {
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto {scheme}
            flush_interval -1
        }
    }

    handle {
        reverse_proxy http://{$ORIGEM_UPSTREAM:127.0.0.1:8080} {
            # Preserva o host publico (a SPA/API geram URLs absolutos a partir dele).
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto {scheme}

            # SSE (chat) e uploads longos: sem buffering, senao a resposta "corta".
            flush_interval -1
        }
    }

    # Se o tunel SSH cai, o upstream esta inacessivel. Em vez de um 502 cru
    # (era o que o Cloudflare mostrava, como Error 1033), serve a pagina de
    # apresentacao com o formulario de contacto.
    handle_errors {
        @offline expression {err.status_code} in [502, 503, 504]
        handle @offline {
            reverse_proxy http://127.0.0.1:8090
        }
        respond "{err.status_code} {err.status_text}"
    }
}

# Servidor de email — **so para o certificado**.
#
# Nao serve a aplicacao nem conteudo nenhum: a existencia deste bloco e o que faz
# o Caddy pedir (e renovar sozinho) o certificado Let's Encrypt de
# `mail.sabemos.studio`, guardando-o no volume `edge_caddy_data`. O contentor do
# Docker Mailserver monta esse volume so de leitura e usa-o com `SSL_TYPE=manual`,
# o que lhe da um certificado de confianca publica para o SMTP — era o que faltava
# para o backend poder enviar com TLS verificado.
#
# Alternativa descartada: o DMS obter o certificado sozinho. Exigiria a porta 80,
# que aqui tem dono (este Caddy, em `network_mode: host`), e dois emissores a
# competir pela mesma porta e uma fonte de falhas silenciosas de renovacao.
#
# Pre-requisito: o registo A `mail.sabemos.studio` tem de apontar para o IP da VM
# **antes** de o certificado poder ser emitido (o desafio HTTP-01 chega a esta
# porta 80). Sem o registo, o Caddy repete a tentativa; sem certificado, o
# mailserver nao arranca.
mail.sabemos.studio {
    # Sonda barata, para se poder confirmar do PC que o bloco esta publicado.
    handle /healthz {
        respond "mail-ok" 200
    }

    # Nada mais: 204 em qualquer outro caminho.
    handle {
        respond "" 204
    }
}
