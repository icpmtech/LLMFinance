# Caddy edge para sabemos.studio
# Substitui o quick tunnel do Cloudflare: o proprio VM serve HTTPS com
# certificado Let's Encrypt automatico.
# Redireciona www para o apex
www.sabemos.studio {
    redir https://sabemos.studio{uri} permanent
}

sabemos.studio {
    # O upstream e o quick tunnel Cloudflare do PC (origin).
    # O hostname e substituido literalmente pelo 05-edge-up.sh (sed), porque
    # o Caddy nao permite placeholders dinamicos no endereco do reverse_proxy.
    reverse_proxy https://__ORIGIN_HOSTNAME__ {
        # O certificado TLS do quick tunnel e valido para *.trycloudflare.com;
        # precisamos de confiar no hostname de origem e transportar o SNI.
        transport http {
            tls_server_name __ORIGIN_HOSTNAME__
            tls_insecure_skip_verify
        }

        # Cabecalhos de proxy
        header_up Host __ORIGIN_HOSTNAME__
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}

        # SSE e imports longas
        flush_interval -1
    }

    respond /healthz "edge-ok" 200
}
