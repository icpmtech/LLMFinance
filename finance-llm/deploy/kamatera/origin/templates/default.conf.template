# Origem local: SPA + proxy da API para o backend Python do PC.
#
# Template do entrypoint da imagem nginx:alpine: ${BACKEND_ORIGIN} e substituido
# a partir das variaveis de ambiente do container (ver compose.yml). O filtro
# NGINX_ENVSUBST_FILTER garante que as variaveis do proprio nginx ($host,
# $remote_addr, ...) ficam intactas.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 512m;

    gzip on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "origin-ok\n";
    }

    # SPA (fallback para index.html nas rotas do cliente).
    location / {
        try_files $uri $uri/ /index.html;
    }

    # O index.html nunca deve ficar em cache (senao um build novo nao aparece).
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # Assets com hash no nome podem ser cacheados indefinidamente.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /sw.js {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    location = /manifest.webmanifest {
        # O nginx nao conhece a extensao .webmanifest.
        types {
            application/manifest+json webmanifest;
        }
        add_header Cache-Control "no-cache";
    }

    # API FastAPI: /api/tickers -> /tickers (o prefixo /api e retirado).
    location /api/ {
        proxy_pass ${BACKEND_ORIGIN}/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Graficos de previsao servidos pelo backend.
    location /forecast/plot/ {
        proxy_pass ${BACKEND_ORIGIN}/forecast/plot/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
