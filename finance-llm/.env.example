FRED_API_KEY=your_fred_api_key_here

# Docker Compose ports
FINANCE_API_PORT=8003
FINANCE_UI_PORT=4180
ELASTICSEARCH_PORT=9200
# Servidor MCP em HTTP (profile "tools")
IQOS_MCP_PORT=8765

# Serviços de apoio (páginas iframe da solução)
# SearXNG — metasearch self-hosted (página «Pesquisa»)
SEARXNG_PORT=8888
# n8n — automação/agentes (página «n8n»)
N8N_PORT=5678
# Hermes Agent (profile "agents") — API OpenAI-compatível + dashboard web
HERMES_API_PORT=8642
# O dashboard não tem contas próprias: o login é validado nas contas do IQ OS pelo
# provider em docker/hermes/plugins/dashboard-auth-iqos (IQOS_API_URL abaixo).
IQOS_API_URL=http://backend:8000
# Chave de assinatura das sessões do dashboard (vazio => gerada por processo)
HERMES_DASHBOARD_IQOS_SECRET=
HERMES_API_KEY=iqos-hermes-api-key-please-change

# MiroFish (profile "mirofish") — motor de previsão por enxame de agentes
# (https://github.com/666ghj/MiroFish). A app abre-se na página iframe «MiroFish».
# O backend do MiroFish recusa arrancar sem chave de LLM e do Zep; por omissão o
# LLM reutiliza o OPENAI_API_KEY/OPENAI_BASE_URL/OPENAI_MODEL do IQ OS.
MIROFISH_API_PORT=5001
# MIROFISH_LLM_API_KEY=
# MIROFISH_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MIROFISH_LLM_MODEL_NAME=qwen-plus
# Zep Cloud (memória de longo prazo dos agentes) — plano gratuito:
# https://app.getzep.com/
# MIROFISH_ZEP_API_KEY=
# Acelerador opcional (2.º modelo para tarefas de volume; vazio = desligado)
# MIROFISH_LLM_BOOST_API_KEY=
# MIROFISH_LLM_BOOST_BASE_URL=
# MIROFISH_LLM_BOOST_MODEL_NAME=
# Rondas de simulação por omissão (menos de 40 nas primeiras tentativas)
# MIROFISH_MAX_ROUNDS=10
# Espelho da imagem base, se o pull da ghcr.io for lento
# MIROFISH_BASE_IMAGE=ghcr.nju.edu.cn/666ghj/mirofish:latest

# Frontend API base.
# Em Docker o frontend é servido pelo nginx, pelo que o valor correto é o caminho
# relativo /api (proxy interno nginx -> backend:8000). Vazio faria a SPA apontar
# para http://127.0.0.1:8002 (o porto do backend de desenvolvimento).
VITE_API_URL=/api

# Elasticsearch a partir do container do backend (não usar 127.0.0.1)
# FINANCE_ES_URL=http://elasticsearch:9200

# Opcional: segredo de autenticação. Se ficar vazio, é usado/reutilizado o
# ficheiro data/.auth_secret (as sessões locais continuam válidas).
# FINANCE_AUTH_SECRET=

# Opcional: chaves de APIs externas usadas pelas ferramentas do agente
# BRAVE_API_KEY=
# SERPAPI_KEY=

# Servidor MCP (container `mcp`, profile "tools") — aponta para o backend do compose
# IQOS_API_URL=http://backend:8000
# Opcional: sessão já emitida, ou credenciais para login automático
# IQOS_API_TOKEN=
# IQOS_API_EMAIL=
# IQOS_API_PASSWORD=
